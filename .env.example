UNSLOTH_API_BASE=http://127.0.0.1:8888
UNSLOTH_API_KEY=sk-unsloth-...
# LLM для перевода (имя из /v1/models). Без него API берёт модель «по умолчанию» —
# при нескольких загруженных это может быть не-LLM и шаг перевода упадаёт с 400
UNSLOTH_TRANSLATE_MODEL=Qwen3.8-27B-MTP

# Каталог готовых видео и рабочих файлов задач (чекпоинты, дорожки, сегменты).
# Запуск в Docker: путь на ХОСТЕ (маунтится в /app/storage и /app/work контейнера).
# Запуск без Docker: абсолютный путь или относительный от каталога приложения.
STORAGE_DIR=./storage
WORK_DIR=./work
